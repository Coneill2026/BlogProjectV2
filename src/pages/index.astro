---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomeImage from '../assets/Home_Image.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import HomeImg from '../assets/Home_Image.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<div>
					<h1>Welcome to Cian's Blog</h1>
					<p>
						This is my corner of the internet for sharing the things I am curious about: the music I
						listen to, the guitars I play, programming projects, and the lessons I pick up along the way.
						Have a look around, read a post, and follow along as I learn in public.
					</p>
					<p><a href="/blog">Read the latest posts</a> or <a href="/about">learn more about me</a>.</p>
				</div>
				<img ={HomeImg} alt="A picture of me" width="240" height="240" />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		display: flex;
		align-items: center;
		gap: 3rem;
	}
	.intro > div {
		flex: 1;
	}
	.intro img {
		flex: 0 0 auto;
		width: 288px;
		height: 288px;
		max-width: 100%;
		object-fit: cover;
	}
	@media (max-width: 600px) {
		.intro {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.5rem;
		}
		.intro img {
			align-self: center;
		}
	}
</style>
